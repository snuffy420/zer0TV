<?xml version="1.0" encoding="utf-8" ?>
<!-- Glow Grid source screen (1080p): four cards a row, a pulsing green focus. -->
<component name="SourceMenu" extends="Group">
  <interface>
    <field id="choices" type="array" />
    <field id="selectedIndex" type="integer" value="0" alwaysNotify="true" />
    <field id="focusedIndex" type="integer" value="0" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/SourceMenu.brs" />
  <script type="text/brightscript" uri="pkg:/components/GlowCommon.brs" />
  <children>
    <Group id="cards" />
    <Poster id="focusRing" uri="pkg:/images/glow/focus.9.png" visible="false" />
    <Group id="hints" translation="[96,1000]" />
    <Animation id="pulse" duration="2.4" repeat="true" easeFunction="inOutQuad">
      <FloatFieldInterpolator key="[0,0.5,1]" keyValue="[1,0.6,1]" fieldToInterp="focusRing.opacity" />
    </Animation>
  </children>
</component>
