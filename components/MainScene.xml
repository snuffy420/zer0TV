                    <Rectangle id="guidePast" translation="[420,0]" width="0" height="460" color="0x070B1250" />
                    <Rectangle id="guideNowLine" width="2" height="460" color="0x00C8FFE6" />
                    <Group id="guideRollText">
                        <Group id="guideRows" />
