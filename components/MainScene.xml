                     the now line, then the text, so the line is over everything but
                     never covers a word. -->
                <!-- Clipped to five rows: a sixth waits below for Scan's roll. -->
                <Group translation="[60,534]" clippingRect="[-10,-6,1820,466]">
                    <Group id="guideRollBg">
                        <Group id="guideRowsBg" />
